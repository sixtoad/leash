# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.25.3
ARG DEBIAN_FRONTEND=noninteractive
ARG UI_SOURCE=ui-build
ARG BASE_BUILD_IMAGE=localhost/leash/build-base:latest
ARG BASE_RUNTIME_IMAGE=localhost/leash/runtime-base:latest

FROM --platform=$BUILDPLATFORM docker.io/library/golang:${GO_VERSION}-bookworm AS go-toolchain

# The pinned eBPF toolchain (#227): Ubuntu noble's clang 18, the compiler the
# CI and release runners generate and verifier-load the LSM objects with.
# Debian bookworm's packaged clang (the golang image's) builds objects that
# kernel 6.8 rejects. internal/lsm/bpf_clang.sh refuses any other major; keep
# the two in step. Go is copied from the official image (static binaries).
# `make lsm-generate-docker` runs in this stage; build-base extends it.
FROM --platform=$BUILDPLATFORM docker.io/library/ubuntu:noble AS bpf-toolchain
ARG DEBIAN_FRONTEND
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        make \
        pkg-config \
        clang-18 \
        llvm-18 \
        libbpf-dev \
        libelf-dev \
        build-essential; \
    rm -rf /var/lib/apt/lists/*
COPY --from=go-toolchain /usr/local/go /usr/local/go
ENV GOPATH=/go \
    PATH=/usr/local/go/bin:/go/bin:$PATH
RUN clang-18 --version | head -1 && go version

FROM --platform=$BUILDPLATFORM bpf-toolchain AS build-base
ARG DEBIAN_FRONTEND
# Install Node.js 20 repo first (required by Next.js 16)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm

ENV GOPATH=/go \
    PATH=/usr/local/go/bin:/go/bin:$PATH \
    PNPM_STORE_DIR=/pnpm/store \
    CI=1

FROM --platform=$BUILDPLATFORM ${BASE_BUILD_IMAGE} AS lsm-generate
ENV GOPATH=/go \
    PATH=/usr/local/go/bin:/go/bin:$PATH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/lsm ./internal/lsm
RUN go install github.com/cilium/ebpf/cmd/bpf2go@v0.19.0
RUN go generate ./internal/lsm

FROM --platform=$BUILDPLATFORM ${BASE_BUILD_IMAGE} AS build
ARG UI_SOURCE
ARG TARGETOS=linux
ARG TARGETARCH
ARG DEBIAN_FRONTEND
ARG COMMIT=dev
ARG BUILD_DATE=unknown
ARG VERSION=dev
ARG CHANNEL=main
ARG GIT_REMOTE_URL=unknown
ARG MANAGER_CONTRACT_VERSION=1
ARG MANAGER_MIN_COMPATIBLE_CONTRACT=1

ENV GOPATH=/go \
    PATH=/usr/local/go/bin:/go/bin:$PATH \
    PNPM_STORE_DIR=/pnpm/store \
    CI=1

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Always consume fresh, pinned BUILDPLATFORM output. This preserves clean
# `docker build` entry points and prevents ignored/stale host files from being
# trusted merely because they are non-empty.
COPY --from=lsm-generate \
    /src/internal/lsm/lsmopen_bpfeb.go \
    /src/internal/lsm/lsmopen_bpfeb.o \
    /src/internal/lsm/lsmopen_bpfel.go \
    /src/internal/lsm/lsmopen_bpfel.o \
    /src/internal/lsm/lsmexec_bpfeb.go \
    /src/internal/lsm/lsmexec_bpfeb.o \
    /src/internal/lsm/lsmexec_bpfel.go \
    /src/internal/lsm/lsmexec_bpfel.o \
    /src/internal/lsm/lsmconnect_bpfeb.go \
    /src/internal/lsm/lsmconnect_bpfeb.o \
    /src/internal/lsm/lsmconnect_bpfel.go \
    /src/internal/lsm/lsmconnect_bpfel.o \
    ./internal/lsm/

RUN --mount=type=cache,target=/pnpm/store \
    --mount=type=cache,target=/cache \
    --mount=type=cache,target=/src/controlui/web/.next/cache \
    if [ "${UI_SOURCE}" = "ui-build" ]; then \
        rm -rf internal/ui/dist && \
        cd controlui/web && \
        pnpm config set store-dir "$PNPM_STORE_DIR" && \
        pnpm install --frozen-lockfile --prefer-offline && \
        node scripts/build-if-changed.mjs --out /tmp/ui-dist --hash /cache/controlui.buildhash && \
        cd /src && \
        mkdir -p internal/ui/dist && \
        rm -rf internal/ui/dist/* && \
        cp -a /tmp/ui-dist/. internal/ui/dist/; \
    else \
        echo "[ui] Using repository-provided assets"; \
    fi

# The generator and compiler both run on BUILDPLATFORM. Keep target binaries
# (especially arm64) limited to cross-compiling and linking preserved assets.
RUN set -eu; \
    for file in \
        internal/lsm/lsmopen_bpfeb.go \
        internal/lsm/lsmopen_bpfeb.o \
        internal/lsm/lsmopen_bpfel.go \
        internal/lsm/lsmopen_bpfel.o \
        internal/lsm/lsmexec_bpfeb.go \
        internal/lsm/lsmexec_bpfeb.o \
        internal/lsm/lsmexec_bpfel.go \
        internal/lsm/lsmexec_bpfel.o \
        internal/lsm/lsmconnect_bpfeb.go \
        internal/lsm/lsmconnect_bpfeb.o \
        internal/lsm/lsmconnect_bpfel.go \
        internal/lsm/lsmconnect_bpfel.o; do \
        test -s "$file" || { echo "missing generated BPF artifact: $file" >&2; exit 1; }; \
    done
# Reduce memory usage and speed up builds using cache mounts and limited parallelism.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath \
        -ldflags "-X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildDate=${BUILD_DATE}" \
        -o /out/leash ./cmd/leash
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -buildvcs=false -trimpath -o /out/leash-entry ./cmd/leash-entry

FROM docker.io/library/debian:bookworm AS runtime-base
ARG DEBIAN_FRONTEND
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    busybox \
    ca-certificates \
    curl \
    dnsutils \
    iproute2 \
    iptables \
    iputils-ping \
    less \
    libbpf1 \
    libelf1 \
    net-tools \
    procps \
    tcpdump \
    tini \
    util-linux \
    vim \
    wget \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /log /cfg /leash

ENV LEASH_LOG_DIR=/log \
    LEASH_CFG_DIR=/cfg \
    LEASH_LOG=/log/events.log \
    LEASH_POLICY=/cfg/leash.cedar \
    LEASH_PROXY_PORT=18000

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/leash", "--daemon"]

FROM ${BASE_RUNTIME_IMAGE} AS final
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_DATE=unknown
ARG CHANNEL=main
ARG GIT_REMOTE_URL=unknown
ARG MANAGER_CONTRACT_VERSION=1
ARG MANAGER_MIN_COMPATIBLE_CONTRACT=1
# The leash binary's own `leash version --json` contract, capabilities (in the
# order that document emits them) and policyLimits. Pinned to internal/version by
# internal/releasecontract tests; update them together.
ARG LEASH_CLI_CONTRACT_VERSION=3
ARG LEASH_CLI_MIN_COMPATIBLE_CONTRACT=0
ARG LEASH_CAPABILITIES=policy,inject-service,runtime,user,require-lsm,machine-output,version-json,resolver-contract-json,idmap-volume,policy-path-limits,container-resource-limits,authz-socket,rootless-daemon,raw-socket-gate,cedar-strict-default,manager-inspect,pin-network-host,container-shm-size
ARG LEASH_POLICY_LIMITS=filePathBytes=255,execPathBytes=64,fileRules=256,execRules=64
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${GIT_REMOTE_URL}" \
      org.opencontainers.image.ref.name="${CHANNEL}" \
      io.leash.manager.contract.version="${MANAGER_CONTRACT_VERSION}" \
      io.leash.manager.contract.min-compatible="${MANAGER_MIN_COMPATIBLE_CONTRACT}" \
      io.leash.manager.cli.contract.version="${LEASH_CLI_CONTRACT_VERSION}" \
      io.leash.manager.cli.contract.min-compatible="${LEASH_CLI_MIN_COMPATIBLE_CONTRACT}" \
      io.leash.manager.capabilities="${LEASH_CAPABILITIES}" \
      io.leash.manager.policy-limits="${LEASH_POLICY_LIMITS}"
COPY --from=build /out/leash /usr/local/bin/leash
COPY --from=build /out/leash-entry /usr/local/bin/leash-entry

FROM ${BASE_RUNTIME_IMAGE} AS final-prebuilt
ARG VERSION=dev
ARG COMMIT=dev
ARG BUILD_DATE=unknown
ARG CHANNEL=main
ARG GIT_REMOTE_URL=unknown
ARG MANAGER_CONTRACT_VERSION=1
ARG MANAGER_MIN_COMPATIBLE_CONTRACT=1
# The leash binary's own `leash version --json` contract, capabilities (in the
# order that document emits them) and policyLimits. Pinned to internal/version by
# internal/releasecontract tests; update them together.
ARG LEASH_CLI_CONTRACT_VERSION=3
ARG LEASH_CLI_MIN_COMPATIBLE_CONTRACT=0
ARG LEASH_CAPABILITIES=policy,inject-service,runtime,user,require-lsm,machine-output,version-json,resolver-contract-json,idmap-volume,policy-path-limits,container-resource-limits,authz-socket,rootless-daemon,raw-socket-gate,cedar-strict-default,manager-inspect,pin-network-host,container-shm-size
ARG LEASH_POLICY_LIMITS=filePathBytes=255,execPathBytes=64,fileRules=256,execRules=64
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${GIT_REMOTE_URL}" \
      org.opencontainers.image.ref.name="${CHANNEL}" \
      io.leash.manager.contract.version="${MANAGER_CONTRACT_VERSION}" \
      io.leash.manager.contract.min-compatible="${MANAGER_MIN_COMPATIBLE_CONTRACT}" \
      io.leash.manager.cli.contract.version="${LEASH_CLI_CONTRACT_VERSION}" \
      io.leash.manager.cli.contract.min-compatible="${LEASH_CLI_MIN_COMPATIBLE_CONTRACT}" \
      io.leash.manager.capabilities="${LEASH_CAPABILITIES}" \
      io.leash.manager.policy-limits="${LEASH_POLICY_LIMITS}"
COPY --from=build /out/leash /usr/local/bin/leash
COPY --from=build /out/leash-entry /usr/local/bin/leash-entry

# Lightweight variant targets for integration tests ---------------------------

FROM docker.io/library/alpine:3.20 AS leash-test-alpine
RUN apk add --no-cache \
    bash \
    ca-certificates \
    coreutils \
    curl \
    grep \
    iputils \
    wget

FROM docker.io/library/debian:bookworm AS leash-test-debian
ARG DEBIAN_FRONTEND
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    curl \
    grep \
    iputils-ping \
    procps \
    wget && \
    rm -rf /var/lib/apt/lists/*

FROM docker.io/library/rockylinux:9 AS leash-test-rocky
RUN dnf install -y --allowerasing --setopt=install_weak_deps=False \
    bash \
    ca-certificates \
    coreutils \
    curl \
    grep \
    iputils \
    procps-ng \
    wget && \
    dnf clean all
